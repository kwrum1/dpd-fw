# DPD-FW 6.18 kernel baseline (generic, no driver-specific options)
# Merge into target/linux/generic/config-6.18 or an OpenWrt config fragment.

CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y

CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_TC_SKB_EXT=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_MQPRIO=y

CONFIG_NET_GRO=y
CONFIG_NET_GSO=y
CONFIG_NET_TSO=y
CONFIG_NET_RX_BUSY_POLL=y

CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_MARK=y

CONFIG_PPP=y
CONFIG_PPPOE=y
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE=y
CONFIG_NET_NS=y
CONFIG_VETH=y

CONFIG_HZ_1000=y
CONFIG_PREEMPT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_RCU_NOCB_CPU=y

CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ_CODEL=y

# Optional: BPF conntrack helpers (verify availability on 6.18 target)
# CONFIG_NF_CONNTRACK_BPF=y
# Optional: KNOD GPU provider (RFC; never default)
# CONFIG_KNOD=n

#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# First boot on a box that exposes a hardware PPE table (IPQ60xx/IPQ807x).
#
# The image uses the same dataplane as X86/RK: einat owns NAT, DPD accelerates
# the forward path, honk's p1 core hands direct flows back to the classic
# chain, and the Vantage chip shows both tables.
#
# The one PPE-specific change: the hardware flowtable cannot offload a
# conntrack-free NAT. With offloading on, RustDesk's flows were marked
# [HW_OFFLOAD] and every TCP control connection stalled in LAST_ACK (measured
# 2026-11-15). Turning L3 offloading off lets einat+DPD own the forwarding path;
# PPE hardware QoS/ACL are separate features and stay available. The PPE L3
# table therefore reads 0/2048 -- that is the honest state, not a claim.
#
# x86/RK have no PPE node and keep fw4's normal offloading.
[ -d /sys/kernel/debug/3a000000.ppe ] || [ -d /sys/kernel/debug/ppe0 ] || exit 0
[ -f /etc/config/dpd_fastpath ] || exit 0

uci -q set dpd_fastpath.global.ppe_mode='fallback'
uci -q commit dpd_fastpath

uci -q set firewall.@defaults[0].flow_offloading='0'
uci -q set firewall.@defaults[0].flow_offloading_hw='0'
zone=$(uci -q show firewall 2>/dev/null |
	sed -n "s/^firewall\.\([^.]*\)\.name='wan'$/\1/p" | head -1)
[ -n "$zone" ] && uci -q set "firewall.$zone.masq='0'"
uci -q commit firewall
exit 0

#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# First boot on a box that exposes a hardware PPE table (IPQ60xx/IPQ807x).
#
# DPD owns NAT here, not einat and not fw4. Reason (measured 2026-11-15 on
# JDCloud RE-CS-07 / IPQ60xx): the hardware flowtable cannot offload a
# conntrack-free NAT. With offloading on, RustDesk's flows were marked
# [HW_OFFLOAD] and every TCP control connection stalled in LAST_ACK; with
# fw4 masquerade it worked, but then DPD cannot accelerate (accelerated
# packets skip netfilter, so conntrack NAT never runs). DPD's own egress/
# ingress NAT plus offloading off gives both: DPD accelerates and RustDesk
# connects instantly (flow_hit rising, no HW_OFFLOAD entries).
#
# x86/RK have no PPE node and keep einat + fw4's normal offloading.
[ -d /sys/kernel/debug/3a000000.ppe ] || [ -d /sys/kernel/debug/ppe0 ] || exit 0
[ -f /etc/config/dpd_fastpath ] || exit 0

uci -q set dpd_fastpath.global.ppe_mode='fallback'
uci -q set dpd_fastpath.global.nat_forward='dpd'
uci -q set dpd_fastpath.global.nat_ingress='dpd'
uci -q set dpd_fastpath.global.mode='stateful'
uci -q commit dpd_fastpath

# The hardware flowtable cannot offload DPD's conntrack-free NAT, so turn
# offloading off; replies of accelerated flows skip conntrack, so fw4 needs
# a blanket WAN->LAN accept (same contract einat used to provide).
uci -q set firewall.@defaults[0].flow_offloading='0'
uci -q set firewall.@defaults[0].flow_offloading_hw='0'
zone=$(uci -q show firewall 2>/dev/null |
	sed -n "s/^firewall\.\([^.]*\)\.name='wan'$/\1/p" | head -1)
[ -n "$zone" ] && uci -q set "firewall.$zone.masq='0'"

if ! uci -q show firewall 2>/dev/null | grep -q "name='DPD-return'"; then
	uci -q add firewall rule >/dev/null
	uci -q set firewall.@rule[-1].name='DPD-return'
	uci -q set firewall.@rule[-1].src='wan'
	uci -q set firewall.@rule[-1].dest='lan'
	uci -q set firewall.@rule[-1].proto='all'
	uci -q set firewall.@rule[-1].target='ACCEPT'
fi
uci -q commit firewall
exit 0

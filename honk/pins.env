# honk p1 core build pins.
#
# The firmware's honk package downloads a prebuilt core from the fixed tag
# `core-p1` published by this repository (see .github/workflows/honk-core.yml).
# `honk/patches/honk-direct-unspec.py` makes direct-classified flows return
# TC_ACT_UNSPEC, so the classic TC chain (DPD) still sees them while honk
# proxies the rest.
#
# Bump CORE_COMMIT together with the patch script; both are anchored and fail
# the workflow when upstream moves the code they edit.
CORE_REPOSITORY=https://github.com/daeuniverse/honk.git
CORE_COMMIT=64848881b7304e250e7a25422f4f1d86a5975eca
HONK_PATCH_REV=p1

# Release tag and asset names consumed by the firmware's honk Makefile.
HONK_SOURCE_TAG=core-p1

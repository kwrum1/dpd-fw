# einat (full-cone NAT) build pins.
#
# einat is the NAT engine of the DPD dataplane: DPD accelerates forwarding,
# einat owns the conntrack-free SNAT/DNAT. The binaries are built here (not in
# the firmware repository) and published under the fixed tag below; the
# firmware package `ebpf/einat-ebpf` only downloads `einat-p2-<arch>`.
#
# Bump EINAT_COMMIT only together with the patches under patches/: both are
# anchored and fail the workflow when upstream moves the code they edit.
EINAT_REPO=https://github.com/EHfive/einat-ebpf.git
EINAT_COMMIT=ba647ce61bd6bdf2cb693961a82b88c442ef049a

# Asset prefix doubles as the release tag. Fixed on purpose: the firmware
# Makefile pins the URL, so a rebuild only has to keep the names stable.
ASSET_PREFIX=einat-p2
RELEASE_TAG=einat-p2
